#!/usr/bin/env bash
# Description: A brief description of what the tool does.

## Sourcing Logic DO NOT EDIT ------------------------------------------------------
# This section is used to determine the location of the script
create_script_name="$(basename -- "$0")"
create_script_path="$(realpath -- "$0")"
create_script_dir="$(dirname -- "$create_script_path")"

# create_get_install_prefix <tool script directory>
# Used to echo the install path prefix.
# This is usually /usr/local or $HOME/.local.
create_get_install_prefix() {
    local tool_path="${1:-}"

    if [[ "$tool_path" = "${HOME}/.local/bin" ]]; then
        echo "$HOME/.local"
    elif [[ "$tool_path" = "/usr/local/bin" ]]; then
        echo "/usr/local"
    elif [[ -d "$tool_path/lib" ]]; then
        echo "$tool_path"
    fi
}

# create_get_lib <install prefix> <tool>
# echos the proper lib path based on the install prefix and tool name.
# needed for proper sourcing of lib files based on where the tool is installed.
create_get_lib() {
    local prefix="${1:-}"
    local tool="${2:-}"

    if [[ -z "$prefix" ]]; then
        echo ""
        return 1
    fi

    if [[ "$prefix" = "$HOME/.local" || "$prefix" = "/usr/local" ]]; then
        echo "${prefix}/lib/${tool}"
    else
        echo "${prefix}/lib"
    fi
}

# create_get_libexec <install prefix> <tool>
# echos the proper libexec path based on the install prefix and tool name.
# needed for proper executing of libexec files based on where the tool is installed.
create_get_libexec() {
    local prefix="${1:-}"
    local tool="${2:-}"

    if [[ -z "$prefix" ]]; then
        echo ""
        return 1
    fi

    if [[ "$prefix" = "$HOME/.local" || "$prefix" = "/usr/local" ]]; then
        echo "${prefix}/libexec/${tool}"
    else
        echo "${prefix}/libexec"
    fi
}

# Grabs other project location info based on the script location.
# Needed to source the correct lib and libexec paths.
# sourcing can be done as follows
# source "create_lib_dir/file to source"
create_install_prefix="$(create_get_install_prefix "$create_script_dir")"
create_libexec_dir="$(create_get_libexec "$create_install_prefix" "$create_script_name")"
create_lib_dir="$(create_get_lib "$create_install_prefix" "$create_script_name")"
## End of Sourcing Logic -----------------------------------------------------------------

## Source Style from its install location.
source "$HOME"/.local/lib/style/bashlib_style.bash


create_version="0.1.0"
create_print_version() {
    println_tag "$style_cyan" "Version" "$create_version"
} 

_create_usage() {
    helpmenu_print_title "Bashlib Create"
    helpmenu_print_subtitle "Used to create bap projects and scripts."
    echo
    helpmenu_print_header "Description"
    echo -e "\tUsed to create a wide range of templates for bash packages."
    echo "This tool can be used to create a new project template as well as the"
    echo "following file types: "
    echo
    echo "  [README, tool.toml, tool script, lib script libexec script]"
    echo
    echo "Take any of the commands for this tool and run with --help to get additional"
    echo "info on that command and its options."
    echo 
    helpmenu_print_header "Usage"
    echo "Usage: create [options]"
    echo
    helpmenu_print_header "Commands"
    helpmenu_print_option "project" "Creates a Bashlib package project template"
    helpmenu_print_option "script" "Creates a template of the requested script type"
    helpmenu_print_option "file" "Creates a template of the requested file."
    helpmenu_print_header "Options"
    helpmenu_print_option "-h | --help" "Show this help message and exit"
    helpmenu_print_option "-v | --version" "Show the version number and exit"
    echo
    helpmenu_print_header "Examples"
    helpmenu_print_example "create" "project"
    helpmenu_print_example "create" "script"
    helpmenu_print_example "create" "script --lib"
    helpmenu_print_example "create" "script --libexec"
    helpmenu_print_example "create" "script --tool"
    helpmenu_print_example "creat" "file --readme"
}

create_parse() {
    [[ "$#" -eq 0 ]] && { print_error "must give some options"; _create_usage ; exit 1; }
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help)
                _create_usage
                exit 0
                ;;
            -v|--version)
                create_print_version
                exit 0
                ;;
	    project) shift; "${create_libexec_dir}/create_project" "$@"; exit 0;;
	    script) shift;  "${create_libexec_dir}/create_script" "$@"; exit 0;;
	    file) shift; "${create_libexec_dir}/create_file" "$@"; exit 0;;
            *)
                echo "Unknown option: $1" >&2
                _create_usage
                exit 1
                ;;
        esac
        shift
    done
}


# Put any tool specific setup code here
create_main() {
    create_parse "$@"
}


# Main is only called if this script is run directly, if it is sourced then main is not called.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    create_main "$@"
fi

